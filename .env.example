# Server Config
PORT=3000
INITIAL_ADMIN_EMAIL=admin@admin.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# Database Config
DATABASE_HOST=postgres
DATABASE_PORT=5432
POSTGRES_EXPOSED_PORT=5432
DATABASE_USER=helpdesk
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=helpdesk


# Auth / JWT
JWT_SECRET=CHANGE_ME_32_BYTES
JWT_EXPIRES_IN=8h

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=15

# Mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SECURE=false
MAIL_FROM="HelpDesk <noreply@helpdesk.com>"

# Cloudinary (External File Storage)
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=helpdesk/attachments
MAX_FILE_SIZE_MB=10

# Notification Job Scheduler (Cron)
NOTIFICATION_CRON_SCHEDULE="*/1 * * * *"
